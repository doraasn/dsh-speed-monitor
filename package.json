{
  "name": "dsh-speed-monitor",
  "version": "0.8.1",
  "description": "DSH 插件「速度监控」：侧栏入口点开右侧面板，用 DSH 的模型清单测中转流式速度；每个模型独立配置间隔/每轮次数/任务，曲线可切首字节/总耗时/吞吐，失败样本不入图。",
  "type": "module",
  "license": "MIT",
  "author": "Y77H",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "speed",
    "latency",
    "monitor",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doraasn/dsh-speed-monitor.git"
  },
  "homepage": "https://github.com/doraasn/dsh-speed-monitor#readme",
  "bugs": {
    "url": "https://github.com/doraasn/dsh-speed-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "main": "lib/index.js"
}
