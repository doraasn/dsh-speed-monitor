{
  "name": "dsh-speed-monitor",
  "version": "0.1.0",
  "description": "DSH 插件「速度监控」：每 5 分钟采样一次 OpenAI 兼容中转的流式速度，侧栏卡片看首字节与总耗时，设置页看曲线。",
  "type": "module",
  "license": "MIT",
  "author": "Y77H",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "speed",
    "latency",
    "monitor",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doraasn/dsh-speed-monitor.git"
  },
  "homepage": "https://github.com/doraasn/dsh-speed-monitor#readme",
  "bugs": {
    "url": "https://github.com/doraasn/dsh-speed-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
